# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Secret
JWT_SECRET=super_secret_jwt_key_wardrobe_tracker_2026_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
# e.g.: postgres://postgres:password@localhost:5432/wardrobe_db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wardrobe_db

# Image Storage Provider: 'local' or 'cloudinary'
STORAGE_PROVIDER=local

# Cloudinary (Optional - Production image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
